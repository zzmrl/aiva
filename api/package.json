{
  "name": "aiva-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Automate.It Virtual Assistant API",
  "main": "app/index.ts",
  "exports": {
    ".": "./app/index.ts",
    "./server": "./app/server.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "bun --sql-preconnect app/index.ts",
    "debug": "DEBUG=api bun dev",
    "dev": "bun --watch app/index.ts",
    "test": "bun test",
    "test:watch": "bun run test --watch",
    "lint": "eslint app/modules app/shared --ext .ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write app"
  },
  "keywords": [],
  "author": "zmrl",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bufferutil": "^4.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "twilio": "^5.13.1",
    "typescript": "^6.0.2",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.11",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "bun": "^1.3.11",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.58.0"
  }
}
