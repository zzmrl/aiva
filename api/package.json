{
  "name": "aiva-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Automate.It Virtual Assistant API",
  "main": "app/index.ts",
  "exports": {
    ".": "./app/index.ts",
    "./server": "./app/server.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "bun --sql-preconnect app/index.ts",
    "debug": "DEBUG=api bun dev",
    "dev": "bun --watch run app/index.ts",
    "test": "bun test",
    "test:watch": "bun run test --watch",
    "lint": "eslint app/modules app/shared --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "zmrl",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "openai": "^6.10.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "twilio": "^5.10.7",
    "typescript": "^5.9.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.4",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "bun": "^1.3.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.49.0"
  }
}
